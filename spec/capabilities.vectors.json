{
  "version": 1,
  "description": "Shared test vectors for the notation of key capabilities (spec/capabilities.md): does a holder of capability list L permit request R. Run by test/capabilities.test.mjs (the JS evaluation, `permits` of @johnhenry/wsh/capabilities, and the full key check of key-options.mjs) and by the unit test in crates/wsh-server/src/auth/permissions.rs (the Rust server). Another implementation runs the cases that name its host class in `hosts` (default: every class). Add a case here, never to one suite only.",
  "spec": "spec/capabilities.md",
  "hostClasses": {
    "node": "the JS implementation: @johnhenry/wsh/server, the memory host, the page host",
    "rust": "the Rust wsh-server: no named endpoints, no execution targets, no wsh-objects; a key line with an objects: entry is refused at load (unknown-capability)"
  },
  "lists": [
    { "name": "no capabilities at all is a valid, empty list", "capabilities": [], "result": "ok" },
    { "name": "every simple capability", "capabilities": ["exec", "pty", "relay", "fs:read", "fs:write"], "result": "ok" },
    { "name": "gateway forms", "capabilities": ["gateway:tcp:db.internal:5432", "gateway:udp:*:53", "gateway:listen:tcp:8080", "gateway:tcp:*.example.com:*", "gateway:tcp:[::1]:80"], "result": "ok" },
    { "name": "unix forms", "capabilities": ["unix:/run/app.sock", "unix:/srv/*", "unix:listen:/run/x.sock", "unix:/*"], "result": "ok" },
    { "name": "named forms, with the wildcard where it is allowed", "capabilities": ["endpoint:logs", "endpoint:*", "target:web", "target:*", "mcp:search", "mcp:*", "rpc:my-proto"], "result": "ok" },
    { "name": "an objects: entry is served by the JS host and refused at load by the Rust server", "capabilities": ["objects:window"], "result": "ok", "hosts": ["node"] },
    { "name": "objects: root, operation and wildcard forms", "capabilities": ["objects:window", "objects:window:get", "objects:*:call", "objects:store:set", "objects:store:on"], "result": "ok", "hosts": ["node"] },
    { "name": "an objects: entry on the Rust server (its stated subset)", "capabilities": ["objects:window"], "result": "refused", "code": "unknown-capability", "hosts": ["rust"] },

    { "name": "an unknown capability fails the whole list, whatever else it holds", "capabilities": ["exec", "teleport"], "result": "refused", "code": "unknown-capability" },
    { "name": "capabilities are case sensitive", "capabilities": ["EXEC"], "result": "refused", "code": "unknown-capability" },
    { "name": "gateway with a protocol this notation does not have", "capabilities": ["gateway:icmp:*:*"], "result": "refused", "code": "unknown-capability" },
    { "name": "gateway: no wildcard of the kind", "capabilities": ["gateway:*"], "result": "refused", "code": "unknown-capability" },
    { "name": "an empty entry", "capabilities": ["exec", ""], "result": "refused", "code": "bad-capability" },
    { "name": "whitespace in an entry", "capabilities": ["exec pty"], "result": "refused", "code": "bad-capability" },
    { "name": "gateway: a host with no port", "capabilities": ["gateway:tcp:db.internal"], "result": "refused", "code": "bad-capability" },
    { "name": "gateway: port 0", "capabilities": ["gateway:tcp:db.internal:0"], "result": "refused", "code": "bad-capability" },
    { "name": "gateway: port above 65535", "capabilities": ["gateway:tcp:db.internal:65536"], "result": "refused", "code": "bad-capability" },
    { "name": "gateway: a port with a leading zero", "capabilities": ["gateway:tcp:db.internal:080"], "result": "refused", "code": "bad-capability" },
    { "name": "gateway: a wildcard in the middle of a host", "capabilities": ["gateway:tcp:a*.example.com:443"], "result": "refused", "code": "bad-capability" },
    { "name": "gateway: a wildcard that is not a whole leading label", "capabilities": ["gateway:tcp:*example.com:443"], "result": "refused", "code": "bad-capability" },
    { "name": "gateway: listen takes a port, not a host", "capabilities": ["gateway:listen:tcp:localhost:80"], "result": "refused", "code": "bad-capability" },
    { "name": "unix: a relative path", "capabilities": ["unix:srv/a.sock"], "result": "refused", "code": "bad-capability" },
    { "name": "unix: a .. segment", "capabilities": ["unix:/srv/../etc/x.sock"], "result": "refused", "code": "bad-capability" },
    { "name": "unix: a wildcard that is not the last segment", "capabilities": ["unix:/srv/*/x.sock"], "result": "refused", "code": "bad-capability" },
    { "name": "mcp: with no tool", "capabilities": ["mcp:"], "result": "refused", "code": "bad-capability" },
    { "name": "rpc: has no wildcard form", "capabilities": ["rpc:*"], "result": "refused", "code": "bad-capability" },
    { "name": "endpoint: a name that does not start with a letter or digit", "capabilities": ["endpoint:-x"], "result": "refused", "code": "bad-capability" },
    { "name": "objects: with no root", "capabilities": ["objects:"], "result": "refused", "code": "bad-capability", "hosts": ["node"] },
    { "name": "objects: an operation that does not exist", "capabilities": ["objects:window:fly"], "result": "refused", "code": "bad-capability", "hosts": ["node"] },
    { "name": "objects: a path is not a root", "capabilities": ["objects:window.document"], "result": "refused", "code": "bad-capability", "hosts": ["node"] },
    { "name": "objects: more than a root and an operation", "capabilities": ["objects:window:get:x"], "result": "refused", "code": "bad-capability", "hosts": ["node"] },
    { "name": "objects: a malformed entry on the Rust server is refused as unknown", "capabilities": ["objects:window:fly"], "result": "refused", "code": "unknown-capability", "hosts": ["rust"] }
  ],
  "requests": [
    { "name": "exec: exec", "capabilities": ["exec"], "request": { "kind": "open", "channel": "exec" }, "permitted": true },
    { "name": "exec does not give a pty", "capabilities": ["exec"], "request": { "kind": "open", "channel": "pty" }, "permitted": false, "capability": "pty" },
    { "name": "pty does not give exec", "capabilities": ["pty"], "request": { "kind": "open", "channel": "exec" }, "permitted": false, "capability": "exec" },
    { "name": "an empty list permits nothing: exec", "capabilities": [], "request": { "kind": "open", "channel": "exec" }, "permitted": false, "capability": "exec" },
    { "name": "an empty list permits nothing: relay", "capabilities": [], "request": { "kind": "relay" }, "permitted": false, "capability": "relay" },
    { "name": "an empty list permits nothing: a file op", "capabilities": [], "request": { "kind": "file-op", "op": "list" }, "permitted": false, "capability": "fs:read" },
    { "name": "an empty list permits nothing: tcp", "capabilities": [], "request": { "kind": "tcp", "host": "example.com", "port": 443 }, "permitted": false, "capability": "gateway:tcp:example.com:443" },
    { "name": "an unknown entry permits nothing, not even what the other entries name", "capabilities": ["exec", "teleport"], "request": { "kind": "open", "channel": "exec" }, "permitted": false, "invalidList": true },
    { "name": "relay", "capabilities": ["relay"], "request": { "kind": "relay" }, "permitted": true },
    { "name": "relay is not granted by exec", "capabilities": ["exec"], "request": { "kind": "relay" }, "permitted": false, "capability": "relay" },
    { "name": "a key with a list may never install a key", "capabilities": ["exec", "pty", "relay", "fs:read", "fs:write", "mcp:*"], "request": { "kind": "key-admin" }, "permitted": false, "code": "key-admin-not-permitted" },

    { "name": "fs:read: a download", "capabilities": ["fs:read"], "request": { "kind": "open", "channel": "file", "direction": "download" }, "permitted": true },
    { "name": "fs:read: an upload", "capabilities": ["fs:read"], "request": { "kind": "open", "channel": "file", "direction": "upload" }, "permitted": false, "capability": "fs:write" },
    { "name": "fs:write: an upload", "capabilities": ["fs:write"], "request": { "kind": "open", "channel": "file", "direction": "upload" }, "permitted": true },
    { "name": "fs:write does not read", "capabilities": ["fs:write"], "request": { "kind": "open", "channel": "file", "direction": "download" }, "permitted": false, "capability": "fs:read" },
    { "name": "fs:read: list", "capabilities": ["fs:read"], "request": { "kind": "file-op", "op": "list" }, "permitted": true },
    { "name": "fs:read: stat", "capabilities": ["fs:read"], "request": { "kind": "file-op", "op": "stat" }, "permitted": true },
    { "name": "fs:read: read", "capabilities": ["fs:read"], "request": { "kind": "file-op", "op": "read" }, "permitted": true },
    { "name": "fs:read: write", "capabilities": ["fs:read"], "request": { "kind": "file-op", "op": "write" }, "permitted": false, "capability": "fs:write" },
    { "name": "fs:read: mkdir", "capabilities": ["fs:read"], "request": { "kind": "file-op", "op": "mkdir" }, "permitted": false, "capability": "fs:write" },
    { "name": "fs:read: remove", "capabilities": ["fs:read"], "request": { "kind": "file-op", "op": "remove" }, "permitted": false, "capability": "fs:write" },
    { "name": "fs:read: rename", "capabilities": ["fs:read"], "request": { "kind": "file-op", "op": "rename" }, "permitted": false, "capability": "fs:write" },
    { "name": "an operation nobody knows needs fs:write", "capabilities": ["fs:read"], "request": { "kind": "file-op", "op": "chmod" }, "permitted": false, "capability": "fs:write" },
    { "name": "fs:write: write", "capabilities": ["fs:write"], "request": { "kind": "file-op", "op": "write" }, "permitted": true },
    { "name": "fs:write: list", "capabilities": ["fs:write"], "request": { "kind": "file-op", "op": "list" }, "permitted": false, "capability": "fs:read" },
    { "name": "wsh-fs needs fs:read and fs:write both", "capabilities": ["fs:read"], "request": { "kind": "open", "channel": "rpc", "protocol": "wsh-fs" }, "permitted": false, "capability": "fs:write" },
    { "name": "wsh-fs with both", "capabilities": ["fs:read", "fs:write"], "request": { "kind": "open", "channel": "rpc", "protocol": "wsh-fs" }, "permitted": true },

    { "name": "mcp:echo: call echo", "capabilities": ["mcp:echo"], "request": { "kind": "mcp-call", "tool": "echo" }, "permitted": true },
    { "name": "mcp:echo: call another tool", "capabilities": ["mcp:echo"], "request": { "kind": "mcp-call", "tool": "shell" }, "permitted": false, "capability": "mcp:shell" },
    { "name": "mcp:echo: list echo", "capabilities": ["mcp:echo"], "request": { "kind": "mcp-tool", "tool": "echo" }, "permitted": true },
    { "name": "mcp:echo: another tool is not listed", "capabilities": ["mcp:echo"], "request": { "kind": "mcp-tool", "tool": "shell" }, "permitted": false, "capability": "mcp:shell" },
    { "name": "mcp tool names are case sensitive", "capabilities": ["mcp:echo"], "request": { "kind": "mcp-call", "tool": "Echo" }, "permitted": false, "capability": "mcp:Echo" },
    { "name": "mcp:*: any tool", "capabilities": ["mcp:*"], "request": { "kind": "mcp-call", "tool": "shell" }, "permitted": true },
    { "name": "mcp discovery needs some mcp entry", "capabilities": ["exec"], "request": { "kind": "mcp" }, "permitted": false, "capability": "mcp:*" },
    { "name": "mcp discovery with one tool", "capabilities": ["mcp:echo"], "request": { "kind": "mcp" }, "permitted": true },
    { "name": "the mcp rpc channel needs mcp:*", "capabilities": ["mcp:echo"], "request": { "kind": "open", "channel": "rpc", "protocol": "mcp" }, "permitted": false, "capability": "mcp:*" },
    { "name": "the mcp rpc channel with mcp:*", "capabilities": ["mcp:*"], "request": { "kind": "open", "channel": "rpc", "protocol": "mcp" }, "permitted": true },
    { "name": "the mcp rpc channel of a handler that narrows by tool is open to a key that names a tool", "capabilities": ["mcp:echo"], "request": { "kind": "open", "channel": "rpc", "protocol": "mcp", "scoped": true }, "permitted": true, "hosts": ["node"] },
    { "name": "a handler that narrows by tool is not open to a key with no mcp entry", "capabilities": ["exec"], "request": { "kind": "open", "channel": "rpc", "protocol": "mcp", "scoped": true }, "permitted": false, "capability": "mcp:<tool>", "hosts": ["node"] },

    { "name": "rpc:NAME opens that protocol", "capabilities": ["rpc:my-proto"], "request": { "kind": "open", "channel": "rpc", "protocol": "my-proto" }, "permitted": true },
    { "name": "rpc:NAME is exact", "capabilities": ["rpc:my-proto"], "request": { "kind": "open", "channel": "rpc", "protocol": "my-proto2" }, "permitted": false, "capability": "rpc:my-proto2" },
    { "name": "rpc: another protocol", "capabilities": ["rpc:my-proto"], "request": { "kind": "open", "channel": "rpc", "protocol": "other" }, "permitted": false, "capability": "rpc:other" },
    { "name": "rpc: wsh-host needs rpc:wsh-host", "capabilities": ["exec"], "request": { "kind": "open", "channel": "rpc", "protocol": "wsh-host" }, "permitted": false, "capability": "rpc:wsh-host" },
    { "name": "rpc: wsh-host with it", "capabilities": ["rpc:wsh-host"], "request": { "kind": "open", "channel": "rpc", "protocol": "wsh-host" }, "permitted": true },

    { "name": "tcp: exact host and port", "capabilities": ["gateway:tcp:db.internal:5432"], "request": { "kind": "tcp", "host": "db.internal", "port": 5432 }, "permitted": true },
    { "name": "tcp: the host is case insensitive", "capabilities": ["gateway:tcp:db.internal:5432"], "request": { "kind": "tcp", "host": "DB.Internal", "port": 5432 }, "permitted": true },
    { "name": "tcp: the pattern's case does not matter either", "capabilities": ["gateway:tcp:DB.Internal:5432"], "request": { "kind": "tcp", "host": "db.internal", "port": 5432 }, "permitted": true },
    { "name": "tcp: another port", "capabilities": ["gateway:tcp:db.internal:5432"], "request": { "kind": "tcp", "host": "db.internal", "port": 22 }, "permitted": false, "capability": "gateway:tcp:db.internal:22" },
    { "name": "tcp: a host that merely starts like it", "capabilities": ["gateway:tcp:db.internal:5432"], "request": { "kind": "tcp", "host": "db.internal.evil.com", "port": 5432 }, "permitted": false, "capability": "gateway:tcp:db.internal.evil.com:5432" },
    { "name": "tcp: a suffix pattern matches a subdomain", "capabilities": ["gateway:tcp:*.example.com:443"], "request": { "kind": "tcp", "host": "api.example.com", "port": 443 }, "permitted": true },
    { "name": "tcp: a suffix pattern matches a deeper subdomain", "capabilities": ["gateway:tcp:*.example.com:443"], "request": { "kind": "tcp", "host": "a.b.example.com", "port": 443 }, "permitted": true },
    { "name": "tcp: a suffix pattern does not match the apex", "capabilities": ["gateway:tcp:*.example.com:443"], "request": { "kind": "tcp", "host": "example.com", "port": 443 }, "permitted": false, "capability": "gateway:tcp:example.com:443" },
    { "name": "tcp: a suffix pattern does not match a look-alike", "capabilities": ["gateway:tcp:*.example.com:443"], "request": { "kind": "tcp", "host": "evilexample.com", "port": 443 }, "permitted": false, "capability": "gateway:tcp:evilexample.com:443" },
    { "name": "tcp: a suffix pattern does not match a host that only contains it", "capabilities": ["gateway:tcp:*.example.com:443"], "request": { "kind": "tcp", "host": "api.example.com.evil.net", "port": 443 }, "permitted": false, "capability": "gateway:tcp:api.example.com.evil.net:443" },
    { "name": "tcp: a suffix pattern is case insensitive", "capabilities": ["gateway:tcp:*.example.com:443"], "request": { "kind": "tcp", "host": "API.Example.COM", "port": 443 }, "permitted": true },
    { "name": "tcp: any port", "capabilities": ["gateway:tcp:db.internal:*"], "request": { "kind": "tcp", "host": "db.internal", "port": 1 }, "permitted": true },
    { "name": "tcp: any host, one port", "capabilities": ["gateway:tcp:*:443"], "request": { "kind": "tcp", "host": "1.2.3.4", "port": 443 }, "permitted": true },
    { "name": "tcp: any host, one port, another port", "capabilities": ["gateway:tcp:*:443"], "request": { "kind": "tcp", "host": "1.2.3.4", "port": 80 }, "permitted": false, "capability": "gateway:tcp:1.2.3.4:80" },
    { "name": "tcp: any host and port", "capabilities": ["gateway:tcp:*:*"], "request": { "kind": "tcp", "host": "anything.example", "port": 9 }, "permitted": true },
    { "name": "tcp: an IPv6 literal", "capabilities": ["gateway:tcp:[::1]:8080"], "request": { "kind": "tcp", "host": "::1", "port": 8080 }, "permitted": true },
    { "name": "tcp: another IPv6 literal", "capabilities": ["gateway:tcp:[::1]:8080"], "request": { "kind": "tcp", "host": "::2", "port": 8080 }, "permitted": false, "capability": "gateway:tcp:::2:8080" },
    { "name": "tcp: a second entry is enough", "capabilities": ["gateway:tcp:a.example:1", "gateway:tcp:b.example:2"], "request": { "kind": "tcp", "host": "b.example", "port": 2 }, "permitted": true },
    { "name": "tcp: the host of one entry with the port of another", "capabilities": ["gateway:tcp:a.example:1", "gateway:tcp:b.example:2"], "request": { "kind": "tcp", "host": "a.example", "port": 2 }, "permitted": false, "capability": "gateway:tcp:a.example:2" },
    { "name": "tcp does not give udp", "capabilities": ["gateway:tcp:*:*"], "request": { "kind": "udp", "host": "1.1.1.1", "port": 53 }, "permitted": false, "capability": "gateway:udp:1.1.1.1:53" },
    { "name": "udp: granted", "capabilities": ["gateway:udp:*:53"], "request": { "kind": "udp", "host": "1.1.1.1", "port": 53 }, "permitted": true },
    { "name": "udp: another port", "capabilities": ["gateway:udp:*:53"], "request": { "kind": "udp", "host": "1.1.1.1", "port": 123 }, "permitted": false, "capability": "gateway:udp:1.1.1.1:123" },
    { "name": "udp does not give tcp", "capabilities": ["gateway:udp:*:*"], "request": { "kind": "tcp", "host": "1.1.1.1", "port": 53 }, "permitted": false, "capability": "gateway:tcp:1.1.1.1:53" },
    { "name": "dns: a name the key may connect to", "capabilities": ["gateway:tcp:db.internal:5432"], "request": { "kind": "dns", "name": "db.internal" }, "permitted": true },
    { "name": "dns: a name it may not", "capabilities": ["gateway:tcp:db.internal:5432"], "request": { "kind": "dns", "name": "other.internal" }, "permitted": false, "capability": "gateway:tcp:other.internal:*" },
    { "name": "dns: a udp entry does not allow a lookup", "capabilities": ["gateway:udp:db.internal:53"], "request": { "kind": "dns", "name": "db.internal" }, "permitted": false, "capability": "gateway:tcp:db.internal:*" },
    { "name": "listen tcp: that port", "capabilities": ["gateway:listen:tcp:8080"], "request": { "kind": "listen-tcp", "port": 8080 }, "permitted": true },
    { "name": "listen tcp: another port", "capabilities": ["gateway:listen:tcp:8080"], "request": { "kind": "listen-tcp", "port": 80 }, "permitted": false, "capability": "gateway:listen:tcp:80" },
    { "name": "listen tcp: any port", "capabilities": ["gateway:listen:tcp:*"], "request": { "kind": "listen-tcp", "port": 80 }, "permitted": true },
    { "name": "connecting is not listening", "capabilities": ["gateway:tcp:*:*"], "request": { "kind": "listen-tcp", "port": 8080 }, "permitted": false, "capability": "gateway:listen:tcp:8080" },
    { "name": "listening is not connecting", "capabilities": ["gateway:listen:tcp:*"], "request": { "kind": "tcp", "host": "example.com", "port": 80 }, "permitted": false, "capability": "gateway:tcp:example.com:80" },

    { "name": "unix: exact path", "capabilities": ["unix:/run/app.sock"], "request": { "kind": "unix", "path": "/run/app.sock" }, "permitted": true },
    { "name": "unix: another path", "capabilities": ["unix:/run/app.sock"], "request": { "kind": "unix", "path": "/run/other.sock" }, "permitted": false, "capability": "unix:/run/other.sock" },
    { "name": "unix: an exact path is not a directory", "capabilities": ["unix:/run/app.sock"], "request": { "kind": "unix", "path": "/run/app.sock/x" }, "permitted": false, "capability": "unix:/run/app.sock/x" },
    { "name": "unix: under a directory", "capabilities": ["unix:/srv/*"], "request": { "kind": "unix", "path": "/srv/a/b.sock" }, "permitted": true },
    { "name": "unix: the directory itself is not under it", "capabilities": ["unix:/srv/*"], "request": { "kind": "unix", "path": "/srv" }, "permitted": false, "capability": "unix:/srv" },
    { "name": "unix: a look-alike directory", "capabilities": ["unix:/srv/*"], "request": { "kind": "unix", "path": "/srvx/a.sock" }, "permitted": false, "capability": "unix:/srvx/a.sock" },
    { "name": "unix: climbing out of the directory", "capabilities": ["unix:/srv/*"], "request": { "kind": "unix", "path": "/srv/../etc/x.sock" }, "permitted": false, "capability": "unix:/srv/../etc/x.sock" },
    { "name": "unix: a . segment", "capabilities": ["unix:/srv/*"], "request": { "kind": "unix", "path": "/srv/./a.sock" }, "permitted": false, "capability": "unix:/srv/./a.sock" },
    { "name": "unix: an empty segment", "capabilities": ["unix:/srv/*"], "request": { "kind": "unix", "path": "/srv//a.sock" }, "permitted": false, "capability": "unix:/srv//a.sock" },
    { "name": "unix: a relative path", "capabilities": ["unix:/srv/*"], "request": { "kind": "unix", "path": "srv/a.sock" }, "permitted": false, "capability": "unix:srv/a.sock" },
    { "name": "unix: /* is every path with a segment", "capabilities": ["unix:/*"], "request": { "kind": "unix", "path": "/a" }, "permitted": true },
    { "name": "unix: /* does not match the root itself", "capabilities": ["unix:/*"], "request": { "kind": "unix", "path": "/" }, "permitted": false, "capability": "unix:/" },
    { "name": "connecting to a socket is not listening on one", "capabilities": ["unix:/run/app.sock"], "request": { "kind": "listen-unix", "path": "/run/app.sock" }, "permitted": false, "capability": "unix:listen:/run/app.sock" },
    { "name": "unix listen: exact path", "capabilities": ["unix:listen:/run/x.sock"], "request": { "kind": "listen-unix", "path": "/run/x.sock" }, "permitted": true },
    { "name": "unix listen: under a directory", "capabilities": ["unix:listen:/run/*"], "request": { "kind": "listen-unix", "path": "/run/a.sock" }, "permitted": true },
    { "name": "listening on a socket is not connecting to one", "capabilities": ["unix:listen:/run/x.sock"], "request": { "kind": "unix", "path": "/run/x.sock" }, "permitted": false, "capability": "unix:/run/x.sock" },

    { "name": "endpoint: that name", "capabilities": ["endpoint:logs"], "request": { "kind": "endpoint", "name": "logs" }, "permitted": true, "hosts": ["node"] },
    { "name": "endpoint: another name", "capabilities": ["endpoint:logs"], "request": { "kind": "endpoint", "name": "db" }, "permitted": false, "capability": "endpoint:db", "hosts": ["node"] },
    { "name": "endpoint: names are case sensitive", "capabilities": ["endpoint:logs"], "request": { "kind": "endpoint", "name": "Logs" }, "permitted": false, "capability": "endpoint:Logs", "hosts": ["node"] },
    { "name": "endpoint:*", "capabilities": ["endpoint:*"], "request": { "kind": "endpoint", "name": "db" }, "permitted": true, "hosts": ["node"] },
    { "name": "endpoint on a target needs the target as well", "capabilities": ["endpoint:logs"], "request": { "kind": "endpoint", "name": "logs", "target": "web" }, "permitted": false, "capability": "target:web", "hosts": ["node"] },
    { "name": "endpoint on a target, with the target", "capabilities": ["endpoint:logs", "target:web"], "request": { "kind": "endpoint", "name": "logs", "target": "web" }, "permitted": true, "hosts": ["node"] },

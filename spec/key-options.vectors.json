    { "name": "mcp needs a tool", "line": "capabilities=\"mcp:\" {KEY}", "result": "refused", "code": "bad-capability" },
    { "name": "target needs a name", "line": "capabilities=\"target:\" {KEY}", "result": "refused", "code": "bad-capability" },

{
  "description": "Shared test vectors for authorized_keys options (wsh #122). Run by test/key-options.test.mjs (Node host) and by the unit test in crates/wsh-server/src/auth/permissions.rs (Rust server): a key line parses to the same permissions on both hosts, and a request is allowed or refused with the same stable code. Add a case here, never to one suite only.",
  "key": "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIFwuwlhewrj73VpJwckueO62uR5tQZacudrGnfSHW89b",
  "keyPlaceholder": "{KEY}",
  "grants": ["pty", "exec", "mcp", "fileTransfer", "relay"],
  "lines": [
    { "name": "no options: full access", "line": "{KEY} alice@host", "result": "ok", "can": ["pty", "exec", "mcp", "fileTransfer", "relay"], "forcedCommand": null, "maxSessions": null },
    { "name": "restrict alone grants nothing", "line": "restrict {KEY}", "result": "ok", "can": [], "forcedCommand": null, "maxSessions": null },
    { "name": "restrict,permit-exec", "line": "restrict,permit-exec {KEY}", "result": "ok", "can": ["exec"], "forcedCommand": null, "maxSessions": null },
    { "name": "restrict,permit-pty also runs commands (a shell can)", "line": "restrict,permit-pty {KEY}", "result": "ok", "can": ["pty", "exec"], "forcedCommand": null, "maxSessions": null },
    { "name": "restrict,permit-pty,no-pty leaves exec only", "line": "restrict,permit-pty,no-pty {KEY}", "result": "ok", "can": ["exec"], "forcedCommand": null, "maxSessions": null },
    { "name": "restrict,permit-mcp", "line": "restrict,permit-mcp {KEY}", "result": "ok", "can": ["mcp"], "forcedCommand": null, "maxSessions": null },
    { "name": "restrict,permit-file-transfer", "line": "restrict,permit-file-transfer {KEY}", "result": "ok", "can": ["fileTransfer"], "forcedCommand": null, "maxSessions": null },
    { "name": "restrict,permit-relay", "line": "restrict,permit-relay {KEY}", "result": "ok", "can": ["relay"], "forcedCommand": null, "maxSessions": null },
    { "name": "every permit-* under restrict", "line": "restrict,permit-pty,permit-exec,permit-mcp,permit-file-transfer,permit-relay {KEY}", "result": "ok", "can": ["pty", "exec", "mcp", "fileTransfer", "relay"], "forcedCommand": null, "maxSessions": null },
    { "name": "no-pty alone removes only the pty", "line": "no-pty {KEY}", "result": "ok", "can": ["exec", "mcp", "fileTransfer", "relay"], "forcedCommand": null, "maxSessions": null },
    { "name": "permit-exec without restrict changes nothing", "line": "permit-exec {KEY}", "result": "ok", "can": ["pty", "exec", "mcp", "fileTransfer", "relay"], "forcedCommand": null, "maxSessions": null },
    { "name": "a forced command is exec only, with or without restrict", "line": "command=\"/usr/bin/uptime\" {KEY}", "result": "ok", "can": ["exec"], "forcedCommand": "/usr/bin/uptime", "maxSessions": null },
    { "name": "restrict,command", "line": "restrict,command=\"/usr/bin/uptime\" {KEY}", "result": "ok", "can": ["exec"], "forcedCommand": "/usr/bin/uptime", "maxSessions": null },
    { "name": "a forced command beats permit-pty", "line": "restrict,permit-pty,permit-mcp,command=\"id\" {KEY}", "result": "ok", "can": ["exec"], "forcedCommand": "id", "maxSessions": null },
    { "name": "a quoted command may hold spaces, commas and escaped quotes", "line": "command=\"echo \\\"hi, there\\\" now\",no-pty {KEY} bob@host", "result": "ok", "can": ["exec"], "forcedCommand": "echo \"hi, there\" now", "maxSessions": null },
    { "name": "a backslash that does not escape a quote is literal", "line": "command=\"printf a\\nb\" {KEY}", "result": "ok", "can": ["exec"], "forcedCommand": "printf a\\nb", "maxSessions": null },
    { "name": "a bare command value", "line": "command=uptime {KEY}", "result": "ok", "can": ["exec"], "forcedCommand": "uptime", "maxSessions": null },
    { "name": "max-sessions bare", "line": "max-sessions=3 {KEY}", "result": "ok", "can": ["pty", "exec", "mcp", "fileTransfer", "relay"], "forcedCommand": null, "maxSessions": 3 },
    { "name": "max-sessions quoted", "line": "restrict,permit-exec,max-sessions=\"2\" {KEY}", "result": "ok", "can": ["exec"], "forcedCommand": null, "maxSessions": 2 },
    { "name": "a tab may separate the options from the key", "line": "restrict,permit-exec\t{KEY}\talice@host", "result": "ok", "can": ["exec"], "forcedCommand": null, "maxSessions": null },
    { "name": "ssh options that ask for less than wsh offers are accepted and change nothing", "line": "no-agent-forwarding,no-X11-forwarding,no-user-rc,no-port-forwarding,restrict,permit-exec {KEY}", "result": "ok", "can": ["exec"], "forcedCommand": null, "maxSessions": null },
    { "name": "blank line", "line": "   ", "result": "skip" },
    { "name": "comment", "line": "# restrict {KEY}", "result": "skip" },
    { "name": "another key type is not served", "line": "ssh-rsa AAAAB3NzaC1yc2EAAAADAQABAAABAQ alice", "result": "skip" },
    { "name": "options in front of another key type", "line": "restrict ssh-rsa AAAAB3NzaC1yc2EAAAADAQABAAABAQ alice", "result": "skip" },
    { "name": "an unterminated quote cannot be split from the key", "line": "command=\"oops {KEY}", "result": "skip" },
    { "name": "an option this host does not know refuses the key", "line": "restrict,from=\"10.0.0.1\" {KEY}", "result": "refused", "code": "unknown-option" },
    { "name": "option names are case sensitive", "line": "Restrict {KEY}", "result": "refused", "code": "unknown-option" },
    { "name": "a future option refuses the key, even next to ones that are known", "line": "permit-exec,permit-teleport {KEY}", "result": "refused", "code": "unknown-option" },
    { "name": "a stray comma", "line": "restrict,,no-pty {KEY}", "result": "refused", "code": "bad-syntax" },
    { "name": "a trailing comma", "line": "restrict, {KEY}", "result": "refused", "code": "bad-syntax" },
    { "name": "single quotes are not quotes", "line": "command='ls' {KEY}", "result": "refused", "code": "bad-syntax" },
    { "name": "text after a closing quote", "line": "command=\"a\"b {KEY}", "result": "refused", "code": "bad-syntax" },
    { "name": "a bare value with an equals sign", "line": "command=a=b {KEY}", "result": "refused", "code": "bad-syntax" },
    { "name": "an empty command", "line": "command=\"\" {KEY}", "result": "refused", "code": "bad-value" },
    { "name": "command without a value", "line": "restrict,command {KEY}", "result": "refused", "code": "bad-value" },
    { "name": "max-sessions=0 is not 'unlimited'", "line": "max-sessions=0 {KEY}", "result": "refused", "code": "bad-value" },
    { "name": "max-sessions that is not a number", "line": "max-sessions=many {KEY}", "result": "refused", "code": "bad-value" },
    { "name": "max-sessions negative", "line": "max-sessions=-1 {KEY}", "result": "refused", "code": "bad-value" },
    { "name": "max-sessions fractional", "line": "max-sessions=1.5 {KEY}", "result": "refused", "code": "bad-value" },
    { "name": "a flag with a value", "line": "restrict=\"yes\" {KEY}", "result": "refused", "code": "bad-value" },
    { "name": "a control character in a command", "line": "command=\"a\u0001b\" {KEY}", "result": "refused", "code": "bad-value" },
    { "name": "command given twice", "line": "command=\"a\",command=\"b\" {KEY}", "result": "refused", "code": "duplicate-option" },
    { "name": "a flag given twice", "line": "restrict,restrict {KEY}", "result": "refused", "code": "duplicate-option" },

    { "name": "capabilities: exec and pty", "line": "capabilities=\"exec,pty\" {KEY}", "result": "ok", "can": ["pty", "exec", "mcp", "fileTransfer", "relay"], "forcedCommand": null, "maxSessions": null, "capabilities": ["exec", "pty"] },
    { "name": "capabilities: a bare value without commas", "line": "capabilities=exec {KEY}", "result": "ok", "can": ["pty", "exec", "mcp", "fileTransfer", "relay"], "forcedCommand": null, "maxSessions": null, "capabilities": ["exec"] },
    { "name": "capabilities: present but empty is deny-all, not 'no option'", "line": "capabilities=\"\" {KEY}", "result": "ok", "can": ["pty", "exec", "mcp", "fileTransfer", "relay"], "forcedCommand": null, "maxSessions": null, "capabilities": [] },
    { "name": "capabilities: every form of the grammar", "line": "capabilities=\"exec,pty,relay,fs:read,fs:write,gateway:tcp:db.internal:5432,gateway:tcp:*.example.com:443,gateway:tcp:*:*,gateway:tcp:[::1]:8080,gateway:udp:*:53,gateway:listen:tcp:8080,gateway:listen:tcp:*,unix:/run/app.sock,unix:/srv/*,unix:listen:/run/x.sock,endpoint:logs,endpoint:*,mcp:echo,mcp:*,target:web,target:*,rpc:wsh-host\" {KEY}", "result": "ok", "can": ["pty", "exec", "mcp", "fileTransfer", "relay"], "forcedCommand": null, "maxSessions": null, "capabilities": ["exec", "pty", "relay", "fs:read", "fs:write", "gateway:tcp:db.internal:5432", "gateway:tcp:*.example.com:443", "gateway:tcp:*:*", "gateway:tcp:[::1]:8080", "gateway:udp:*:53", "gateway:listen:tcp:8080", "gateway:listen:tcp:*", "unix:/run/app.sock", "unix:/srv/*", "unix:listen:/run/x.sock", "endpoint:logs", "endpoint:*", "mcp:echo", "mcp:*", "target:web", "target:*", "rpc:wsh-host"] },
    { "name": "capabilities narrow the options, they do not widen them", "line": "restrict,permit-exec,capabilities=\"exec,pty\" {KEY}", "result": "ok", "can": ["exec"], "forcedCommand": null, "maxSessions": null, "capabilities": ["exec", "pty"] },
    { "name": "expires, UTC", "line": "expires=\"2030-01-01T00:00:00Z\" {KEY}", "result": "ok", "can": ["pty", "exec", "mcp", "fileTransfer", "relay"], "forcedCommand": null, "maxSessions": null, "expires": 1893456000 },
    { "name": "expires, with an offset", "line": "expires=\"2030-01-01T00:00:00+01:00\" {KEY}", "result": "ok", "can": ["pty", "exec", "mcp", "fileTransfer", "relay"], "forcedCommand": null, "maxSessions": null, "expires": 1893452400 },
    { "name": "expires, fractional seconds are dropped", "line": "expires=\"2030-01-01T00:00:00.999Z\" {KEY}", "result": "ok", "can": ["pty", "exec", "mcp", "fileTransfer", "relay"], "forcedCommand": null, "maxSessions": null, "expires": 1893456000 },
    { "name": "expires on a leap day", "line": "expires=\"2028-02-29T12:00:00Z\" {KEY}", "result": "ok", "can": ["pty", "exec", "mcp", "fileTransfer", "relay"], "forcedCommand": null, "maxSessions": null, "expires": 1835438400 },
    { "name": "capabilities and expires together, with other options", "line": "restrict,permit-exec,max-sessions=2,capabilities=\"exec\",expires=\"2030-01-01T00:00:00Z\" {KEY}", "result": "ok", "can": ["exec"], "forcedCommand": null, "maxSessions": 2, "capabilities": ["exec"], "expires": 1893456000 },
    { "name": "an unknown capability refuses the key", "line": "capabilities=\"exec,teleport\" {KEY}", "result": "refused", "code": "unknown-capability" },
    { "name": "capability names are case sensitive", "line": "capabilities=\"Exec\" {KEY}", "result": "refused", "code": "unknown-capability" },
    { "name": "fs has read and write only", "line": "capabilities=\"fs:execute\" {KEY}", "result": "refused", "code": "unknown-capability" },
    { "name": "an empty capability", "line": "capabilities=\"exec,,pty\" {KEY}", "result": "refused", "code": "bad-capability" },
    { "name": "a trailing comma in capabilities", "line": "capabilities=\"exec,\" {KEY}", "result": "refused", "code": "bad-capability" },
    { "name": "no spaces inside the capability list", "line": "capabilities=\"exec, pty\" {KEY}", "result": "refused", "code": "bad-capability" },
    { "name": "a gateway capability needs a port", "line": "capabilities=\"gateway:tcp:db.internal\" {KEY}", "result": "refused", "code": "bad-capability" },
    { "name": "a port out of range", "line": "capabilities=\"gateway:tcp:db.internal:99999\" {KEY}", "result": "refused", "code": "bad-capability" },
    { "name": "port 0", "line": "capabilities=\"gateway:tcp:db.internal:0\" {KEY}", "result": "refused", "code": "bad-capability" },
    { "name": "a gateway capability needs a host", "line": "capabilities=\"gateway:tcp::80\" {KEY}", "result": "refused", "code": "bad-capability" },
    { "name": "a wildcard in the middle of a host", "line": "capabilities=\"gateway:tcp:a*b.example.com:80\" {KEY}", "result": "refused", "code": "bad-capability" },
    { "name": "an unknown gateway protocol", "line": "capabilities=\"gateway:sctp:host:1\" {KEY}", "result": "refused", "code": "unknown-capability" },

    { "name": "expires, second 60", "line": "expires=\"2030-01-01T00:00:60Z\" {KEY}", "result": "refused", "code": "bad-value" },
    { "name": "expires, an offset of 24 hours", "line": "expires=\"2030-01-01T00:00:00+24:00\" {KEY}", "result": "refused", "code": "bad-value" },
    { "name": "expires without a value", "line": "expires {KEY}", "result": "refused", "code": "bad-value" },
    { "name": "expires given twice", "line": "expires=\"2030-01-01T00:00:00Z\",expires=\"2031-01-01T00:00:00Z\" {KEY}", "result": "refused", "code": "duplicate-option" }

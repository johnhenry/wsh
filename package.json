{
  "name": "@johnhenry/wsh",
  "version": "0.62.1",
  "description": "Web Shell \u2014 browser-native remote command execution over WebTransport and WebSocket with Ed25519 authentication",
  "type": "module",
  "main": "./src/index.mjs",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.mjs"
    },
    "./server": {
      "types": "./src/server/index.d.ts",
      "import": "./src/server/index.mjs"
    },
    "./gateway": {
      "types": "./src/gateway.d.ts",
      "import": "./src/gateway.mjs"
    },
    "./address-guard": {
      "types": "./src/address-guard.d.ts",
      "import": "./src/address-guard.mjs"
    },
    "./pipe-relay": {
      "types": "./src/pipe-relay.d.ts",
      "import": "./src/pipe-relay.mjs"
    },
    "./memory": {
      "types": "./src/memory-host.d.ts",
      "import": "./src/memory-host.mjs"
    },
    "./host": {
      "types": "./src/host.d.ts",
      "import": "./src/host.mjs"
    },
    "./reverse": {
      "types": "./src/reverse-host.d.ts",
      "import": "./src/reverse-host.mjs"
    },
    "./page": {
      "types": "./src/page-host.d.ts",
      "import": "./src/page-host.mjs"
    },
    "./objects": {
      "types": "./src/objects.d.ts",
      "import": "./src/objects.mjs"
    },
    "./objects-types": {
      "types": "./src/objects-types.d.ts",
      "import": "./src/objects-types.mjs"
    },
    "./testing": {
      "types": "./src/testing.d.ts",
      "import": "./src/testing.mjs"
    },
    "./mcp-stdio": {
      "types": "./src/mcp-stdio.d.ts",
      "import": "./src/mcp-stdio.mjs"
    },
    "./capabilities": {
      "types": "./src/capabilities.d.ts",
      "import": "./src/capabilities.mjs"
    },
    "./duplex": {
      "types": "./src/duplex.d.ts",
      "import": "./src/duplex.mjs"
    },
    "./identity": {
      "types": "./src/identity.d.ts",
      "import": "./src/identity.mjs"
    },
    "./spec/*.json": "./spec/*.json",
    "./spec/*.md": "./spec/*.md",
    "./spec/wsh-v1.yaml": "./spec/wsh-v1.yaml"
  },
  "bin": {
    "wsh-mcp": "./bin/wsh-mcp.mjs",
    "wsh-objects-types": "./bin/wsh-objects-types.mjs"
  },
  "sideEffects": false,
  "types": "./src/index.d.ts",
  "files": [
    "src",
    "bin",
    "spec/*.json",
    "spec/*.md",
    "spec/wsh-v1.yaml",
    "LICENSE",
    "README.md"
  ],
  "optionalDependencies": {
    "@noble/post-quantum": "^0.7.0"
  },
  "peerDependencies": {
    "@fails-components/webtransport": "^1.6.4",
    "@fails-components/webtransport-transport-http3-quiche": "^1.6.4",
    "ws": "^8.0.0",
    "@modelcontextprotocol/sdk": "^1.17.0"
  },
  "peerDependenciesMeta": {
    "@fails-components/webtransport": {
      "optional": true
    },
    "@fails-components/webtransport-transport-http3-quiche": {
      "optional": true
    },
    "ws": {
      "optional": true
    },
    "@modelcontextprotocol/sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@fails-components/webtransport": "^1.6.4",
    "@fails-components/webtransport-transport-http3-quiche": "^1.6.4",
    "@johnhenry/browsermesh-primitives": "^0.5.0",
    "@playwright/test": "^1.65.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.0",
    "ws": "^8.21.0",
    "@modelcontextprotocol/sdk": "^1.17.0"
  },
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "test:rust": "node --test --test-timeout=180000 test/rust/*.test.mjs",
    "test:browser": "playwright test --config test/browser/playwright.config.mjs",
    "size": "node scripts/bundle-size.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "codegen": "node spec/codegen.mjs",
    "codegen:check": "node scripts/codegen-check.mjs",
    "matrix": "node scripts/message-matrix.mjs",
    "matrix:check": "node scripts/message-matrix.mjs --check",
    "examples": "for f in examples/0*.mjs; do echo \"== $f\" && node \"$f\" || exit 1; done",
    "example:01": "node examples/01-frames-survive-fragmented-transport.mjs",
    "example:02": "node examples/02-tampered-challenge-fails-authentication.mjs",
    "example:03": "node examples/03-handshake-to-exec-over-in-process-pipe.mjs",
    "example:04": "node examples/04-recording-replays-with-original-timing.mjs",
    "example:05": "node examples/05-remote-mcp-tools-called-through-bridge.mjs",
    "example:06": "node examples/06-rpc-requests-answered-out-of-order.mjs"
  },
  "keywords": [
    "wsh",
    "web-shell",
    "terminal",
    "webtransport",
    "websocket",
    "ed25519",
    "browser",
    "cbor",
    "remote-shell",
    "ssh",
    "pty"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnhenry/wsh.git"
  },
  "author": "John Henry",
  "engines": {
    "node": ">=26.0.0"
  },
  "homepage": "https://opensource.johnhenry.me/wsh/"
}
